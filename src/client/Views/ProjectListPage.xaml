<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="DavidsApp.Client.Views.ProjectListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DavidsApp.Client.ViewModels"
    xmlns:models="clr-namespace:DavidsApp.Client.Models;assembly=DavidsApp.Client.Core"
    x:DataType="vm:ProjectListViewModel"
    Title="Lead Testing — Projects">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Start a new project" FontAttributes="Bold" FontSize="18" />

            <Entry Placeholder="Testing address" Text="{Binding NewTestingAddress}" />
            <Entry Placeholder="Job number (optional)" Text="{Binding NewJobNumber}" />
            <Button Text="Start Project" Command="{Binding StartProjectCommand}" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding ErrorMessage}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />

            <Label Text="Or resume an existing project" FontAttributes="Bold" FontSize="18" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <CollectionView ItemsSource="{Binding Projects}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Project">
                        <Grid Padding="10" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding TestingAddress}" FontAttributes="Bold" />
                                <Label Text="{Binding JobNumber}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                Text="Resume"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProjectListViewModel}}, Path=SelectProjectCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
